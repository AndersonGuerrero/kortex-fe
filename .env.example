# URL base de la API del Backend (Django)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Auth0 Configuration (Login social con Google)
# Dominio del tenant Auth0 (ej: mi-app.us.auth0.com)
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
# Client ID de la aplicación SPA en Auth0
VITE_AUTH0_CLIENT_ID=tu-client-id-aqui
# Identificador de la API registrada en Auth0
VITE_AUTH0_AUDIENCE=https://api.kortex.local

# Wompi — Tokenización de tarjetas (solo se usa la PUBLIC KEY en el frontend)
# Sandbox: pub_test_xxx | Producción: pub_prod_xxx
VITE_WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXX
# URL base de la API de Wompi (sandbox por defecto)
VITE_WOMPI_BASE_URL=https://sandbox.wompi.co/v1
